---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CourseClient from '../components/CourseClient.astro';
import { GUIDES } from '../lib/guides.mjs';
import { START_LESSONS } from '../lib/start.mjs';

const lists = (await getCollection('lists')).sort((a, b) => a.data.number - b.data.number);
const chapters = await getCollection('guides');
const count = (slug) => chapters.filter((chapter) => chapter.id.startsWith(`${slug}/`)).length;
const totalMinutes = START_LESSONS.reduce((sum, lesson) => sum + lesson.minutes, 0);
---

<Base
  wide
  title="Lemon Agent · Learn to work with coding agents"
  description="A practical, hands-on guide for moving from ChatGPT conversations to safe, verifiable work with a coding agent."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span>LEMON AGENT</span> · a field guide to coding agents</p>
      <h1>You know how to chat with AI. Now learn how to work with one.</h1>
      <p class="intro">
        A coding agent can inspect a project, edit files, run commands, and
        check its work. This hands-on guide shows you how to give it a safe
        job, stay in control, and decide whether the result is actually right.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/start/">Start your first session</a>
        <a class="button secondary" href={`/start/${START_LESSONS[0].id}/#make-the-call`}>See a two-minute example</a>
      </div>
      <p class="audience-note">Start with the course if you are moving beyond chat. Use the field manual at any skill level when you want a sharper working system.</p>
      <p class="audience-note">Already working with a coding agent? Skip ahead to <a href="/guides/">the field manual</a> and <a href="/agent-workflow-failure-list/">the watch-out lists</a>.</p>
    </div>

    <aside class="session-card" aria-label="An example agent session">
      <div class="session-head">
        <span>EXAMPLE: A FIRST SESSION</span>
        <i>readable · reversible · checked</i>
      </div>
      <ol>
        <li><span>01</span><div><strong>Scope</strong><p>Change one homepage headline. Leave layout and colors alone.</p></div></li>
        <li><span>02</span><div><strong>Plan</strong><p>Inspect the page, name the file, then wait.</p></div></li>
        <li><span>03</span><div><strong>Act</strong><p>One focused edit. No nearby cleanup.</p></div></li>
        <li><span>04</span><div><strong>Verify</strong><p>Build passes. The requested text renders.</p></div></li>
        <li><span>05</span><div><strong>Review</strong><p>The diff contains exactly one intended change.</p></div></li>
      </ol>
      <p class="session-result"><span>✓</span> You delegated the work without delegating the judgment.</p>
    </aside>
  </section>

  <section class="outcomes" aria-labelledby="outcomes-title">
    <div class="section-heading">
      <p class="eyebrow">What you will learn</p>
      <h2 id="outcomes-title">A better working loop, not a magic prompt.</h2>
    </div>
    <div class="outcome-grid">
      <article><span>01</span><h3>Give it a bounded task</h3><p>Turn “improve my site” into a job with a clear scope and finish line.</p></article>
      <article><span>02</span><h3>Stay involved without hovering</h3><p>Know when the agent should inspect, plan, act, ask, or stop.</p></article>
      <article><span>03</span><h3>Make the system improve</h3><p>Save corrections in project instructions, reusable skills, and small dependable tools.</p></article>
    </div>
  </section>

  <section class="outcomes" aria-labelledby="leverage-title">
    <div class="section-heading">
      <p class="eyebrow">Build leverage</p>
      <h2 id="leverage-title">Make every useful session improve the next one.</h2>
    </div>
    <div class="outcome-grid">
      <article><span>01</span><h3>Let corrections survive the chat</h3><p>Put project facts in <code>AGENTS.md</code> or <code>CLAUDE.md</code>. Package workflows as skills, with <code>npx skills</code> managing shared installs.</p></article>
      <article><span>02</span><h3>Prefer a clear tool surface</h3><p>Use a CLI for direct local work, an API for service access, and MCP when a standard agent connection adds value.</p></article>
      <article><span>03</span><h3>Harvest small deterministic tools</h3><p>Let code perform exact repeated operations while the agent handles judgment, orchestration, and glue.</p></article>
    </div>
  </section>

  <section class="start-preview" aria-labelledby="start-title">
    <div class="start-intro">
      <p class="eyebrow">Start here</p>
      <h2 id="start-title">Seven short lessons. One real workflow.</h2>
      <p>Each lesson gives you one idea, a decision to practice, and something you can paste into your own coding agent.</p>
      <a class="button primary" href="/start/">Open the {totalMinutes}-minute course</a>
    </div>
    <ol class="start-list">
      {START_LESSONS.map((lesson) => (
        <li data-lesson-id={lesson.id}>
          <a href={`/start/${lesson.id}/`}>
            <span>{String(lesson.step).padStart(2, '0')}</span>
            <div><strong>{lesson.title}</strong><small>{lesson.short}</small></div>
            <i aria-hidden="true">→</i>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="manual" aria-labelledby="manual-title">
    <div class="section-heading manual-heading">
      <div>
        <p class="eyebrow">Go deeper</p>
        <h2 id="manual-title">The field manual</h2>
      </div>
      <p>Patterns from measured use, written for clarity without reducing the technical depth.</p>
    </div>
    <div class="guide-grid">
      {GUIDES.map((guide) => (
        <a class={`guide-card citrus-${guide.citrus}`} href={`/guides/${guide.slug}/`}>
          <p>{count(guide.slug)} {count(guide.slug) === 1 ? 'pattern' : 'patterns'}</p>
          <h3>{guide.title}</h3>
          <span>{guide.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="reference-bar">
    <div>
      <p class="eyebrow">Check your work</p>
      <h2>Use the watch-out lists as a final pass.</h2>
    </div>
    <div class="reference-links">
      {lists.map((list) => (
        <a class="citrus-blood-orange" href={`/${list.id}/`}>
          <strong>{list.data.title}</strong>
          <span>{list.data.entries} concrete failure patterns →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="section-heading">
      <p class="eyebrow">Services agents can call</p>
      <h2 id="services-title">Five live endpoints, priced per call.</h2>
      <p class="services-note">Paid over x402. Prices verified 2026-09-02.</p>
    </div>
    <div class="service-grid">
      <a class="service-card" href="https://toolshed.lemon-agent.dev">
        <strong>Toolshed</strong>
        <span>19 hosted format converters, one call per conversion.</span>
        <em>$0.002-$0.006/call</em>
        <code>https://toolshed.lemon-agent.dev</code>
      </a>
      <a class="service-card" href="https://10x402.com">
        <strong>10x402</strong>
        <span>x402 conformance linting, 82 checks per report.</span>
        <em>$0.005-$0.25/call</em>
        <code>https://10x402.com</code>
      </a>
      <a class="service-card" href="https://kino402.com">
        <strong>kino402</strong>
        <span>Frontier video and TTS generation, one call per render.</span>
        <em>$0.008-$0.372/call</em>
        <code>https://kino402.com</code>
      </a>
      <a class="service-card" href="https://penny402.fun">
        <strong>penny402</strong>
        <span>Ten muse and oracle attractions, one flat price per call.</span>
        <em>$0.0025/call</em>
        <code>https://penny402.fun</code>
      </a>
      <a class="service-card" href="https://parallax402.com">
        <strong>Parallax</strong>
        <span>Settlement-graph market facts about the x402 economy.</span>
        <em>$0.010/call</em>
        <code>https://parallax402.com</code>
      </a>
    </div>
  </section>

  <section class="experiments">
    <p><strong>Experiments:</strong> Lemon Agent also houses small tools and agent-facing services. The first, pathgrip, is a bookmark store agents can call. It runs as the operator’s own instance today; there is nothing for you to sign up for yet, and we’d rather say so than pretend. <a href="https://pathgrip.net">See its current status →</a></p>
  </section>
  <CourseClient />
</Base>

<style>
  .eyebrow { margin: 0 0 0.75rem; color: var(--accent-ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .eyebrow span { display: inline-block; padding: 0.08rem 0.45rem; background: var(--chartreuse); color: var(--chip-ink); }
  .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr); gap: clamp(2.5rem, 7vw, 6rem); align-items: center; min-height: 34rem; padding: 1rem 0 5.5rem; }
  .hero h1 { max-width: 12ch; }
  .intro { max-width: 39rem; color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.28rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.7rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; padding: 0.72rem 1rem; border: 1px solid var(--border-hover); border-radius: 0.42rem; font-weight: 750; text-decoration: none; transition: transform 120ms ease, background 120ms ease; }
  .button:hover { transform: translateY(-1px); }
  .button.primary { background: var(--chartreuse); color: var(--chip-ink); }
  .button.secondary { background: var(--card); color: var(--accent-ink); }
  .audience-note { max-width: 34rem; margin-top: 1rem; color: var(--muted); font-size: 0.82rem; }
  .session-card { padding: 1.15rem; border: 1px solid var(--border); border-radius: 0.8rem; background: var(--card); box-shadow: var(--glow); }
  .session-head { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.75rem; color: var(--muted); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.66rem; letter-spacing: 0.08em; }
  .session-head i { font-style: normal; letter-spacing: 0; }
  .session-card ol { list-style: none; margin: 0; padding: 0; }
  .session-card li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.75rem; padding: 0.72rem 0; border-top: 1px solid var(--border); }
  .session-card li > span { color: var(--accent-ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.73rem; font-weight: 750; }
  .session-card strong { font-size: 0.9rem; }
  .session-card li p { margin: 0.1rem 0 0; color: var(--muted); font-size: 0.8rem; }
  .session-result { margin: 0.5rem 0 0; padding: 0.8rem; background: var(--note-bg); color: var(--muted); font-size: 0.82rem; }
  .session-result span { color: var(--live-ink); font-weight: 800; }
  .outcomes, .manual { padding: 5rem 0; border-top: 1px solid var(--border); }
  .section-heading h2, .start-intro h2, .reference-bar h2 { max-width: 18ch; margin: 0; color: var(--ink); font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -0.04em; text-transform: none; }
  .section-heading h2::before, .start-intro h2::before, .reference-bar h2::before { content: none; }
  .outcome-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  .outcome-grid article { padding: 1.2rem; border: 1px solid var(--border); border-radius: 0.65rem; background: var(--card); }
  .outcome-grid article > span { color: var(--accent-ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.7rem; font-weight: 800; }
  .outcome-grid h3 { margin: 1rem 0 0.45rem; }
  .outcome-grid p { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .start-preview { display: grid; grid-template-columns: minmax(18rem, 0.7fr) minmax(22rem, 1.3fr); gap: clamp(2.5rem, 8vw, 7rem); padding: 5rem 0; border-top: 1px solid var(--border); }
  .start-intro { align-self: start; position: sticky; top: 1.5rem; }
  .start-intro > p:not(.eyebrow) { color: var(--muted); }
  .start-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .start-list li { border-bottom: 1px solid var(--border); }
  .start-list a { display: grid; grid-template-columns: 2rem 1fr 1rem; gap: 0.8rem; align-items: center; padding: 0.9rem 0; color: inherit; text-decoration: none; }
  .start-list a:hover strong { color: var(--accent-ink); }
  .start-list a > span { color: var(--accent-ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.72rem; font-weight: 800; }
  .start-list strong, .start-list small { display: block; }
  .start-list small { color: var(--muted); }
  .start-list i { color: var(--accent-ink); font-style: normal; }
  .start-list li.complete strong::after { content: '  ✓'; color: var(--live-ink); }
  .manual-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; }
  .manual-heading > p { max-width: 28rem; margin: 0; color: var(--muted); }
  .guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.85rem; margin-top: 2rem; }
  .guide-card { padding: 1.15rem; border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: 0.65rem; background: var(--card); color: inherit; text-decoration: none; }
  .guide-card:hover { border-color: var(--accent-hover); border-top-color: var(--accent); background: var(--accent-soft); box-shadow: var(--glow); }
  .guide-card p { margin: 0; color: var(--muted); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.7rem; text-transform: uppercase; }
  .guide-card h3 { margin: 0.8rem 0 0.45rem; color: var(--accent-ink); }
  .guide-card span { color: var(--muted); font-size: 0.85rem; }
  .reference-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin: 2rem 0 5rem; padding: 2rem; border-radius: 0.8rem; background: var(--note-bg); }
  .reference-links { display: grid; gap: 0.75rem; }
  .reference-links a { display: block; padding: 0.8rem; border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 0.45rem; background: var(--card); color: inherit; text-decoration: none; }
  .reference-links a:hover { border-color: var(--accent-hover); border-left-color: var(--accent); background: var(--accent-soft); }
  .reference-links strong, .reference-links span { display: block; }
  .reference-links span { color: var(--muted); font-size: 0.8rem; }
  .services { padding: 0 0 3rem; }
  .services-note { max-width: 34rem; margin: 0.6rem 0 0; color: var(--muted); font-size: 0.82rem; }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.85rem; margin-top: 2rem; }
  .service-card { display: block; padding: 1.15rem; border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 0.65rem; background: var(--card); color: inherit; text-decoration: none; }
  .service-card:hover { border-color: var(--accent-hover); border-left-color: var(--accent); background: var(--accent-soft); box-shadow: var(--glow); }
  .service-card strong { display: block; color: var(--accent-ink); }
  .service-card span { display: block; margin: 0.45rem 0; color: var(--muted); font-size: 0.85rem; }
  .service-card em { display: block; color: var(--ink); font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 0.78rem; font-style: normal; font-weight: 750; }
  .service-card code { display: block; margin-top: 0.3rem; color: var(--muted); font-size: 0.72rem; word-break: break-all; }
  .experiments { color: var(--muted); font-size: 0.82rem; }
  @media (max-width: 52rem) {
    .hero, .start-preview { grid-template-columns: 1fr; }
    .hero { min-height: 0; padding-top: 0; }
    .session-card { max-width: 34rem; }
    .outcome-grid, .guide-grid, .service-grid { grid-template-columns: 1fr; }
    .start-intro { position: static; }
    .manual-heading, .reference-bar { grid-template-columns: 1fr; }
    .manual-heading { align-items: start; flex-direction: column; }
  }
</style>

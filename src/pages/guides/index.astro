---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../lib/guides.mjs';

const chapters = await getCollection('guides');
const count = (slug) => chapters.filter((c) => c.id.startsWith(`${slug}/`)).length;
---
<Base
  title="The field manual"
  description="Field guides for working with agents: coding-agent patterns, Git workflows, keeping a vault, auditing what AI says about you, and giving an agent money it can spend. One clear pattern at a time."
>
  <p class="kicker">Lemon Agent · {GUIDES.length} deeper guides</p>
  <h1>The field manual</h1>
  <p>
    Use these field guides at any skill level, <strong>one pattern at a
    time</strong>. The writing stays plain while the ideas remain technical.
    Every step explains the pattern, gives you a way to try it, and ends with
    an optional prompt you can adapt to your agent.
  </p>
  <div class="cards">
    {GUIDES.map((g) => (
      <a class={`card citrus-${g.citrus}`} href={`/guides/${g.slug}/`}>
        <p class="card-kicker">{count(g.slug)} {count(g.slug) === 1 ? 'pattern' : 'patterns'}</p>
        <p class="card-title">{g.title}</p>
        <p class="card-blurb">{g.blurb}</p>
      </a>
    ))}
  </div>
  <p class="backlink">
    <a href="/start/">← Start here</a> · for agents: raw chapters at
    <code>/guides/&lt;guide&gt;/*.md</code>, catalog at
    <a href="/catalog.json">/catalog.json</a>
  </p>
</Base>

<style>
  .cards { display: grid; gap: 0.9rem; margin: 1.4rem 0 0.5rem; }
  .card {
    display: block;
    padding: 1rem 1.2rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms ease, background 120ms ease, box-shadow 120ms ease;
  }
  .card:hover { border-color: var(--accent-hover); border-left-color: var(--accent); background: var(--accent-soft); box-shadow: var(--glow); }
  .card-kicker { margin: 0; font-size: 0.75rem; color: var(--muted); letter-spacing: 0.05em; }
  .card-title { margin: 0.3rem 0 0.25rem; font-weight: 700; font-size: 1.05rem; color: var(--accent-ink); }
  .card-blurb { margin: 0; font-size: 0.85rem; color: var(--muted); }
</style>

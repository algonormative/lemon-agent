---
import Analytics from '../components/Analytics.astro';
import PostHog from '../components/PostHog.astro';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  /** Citrus variety for domain theming (lime, tangerine, grapefruit,
   *  blood-orange). Omit for house pages: the base is lemon. */
  citrus?: string;
}

const { title, description, wide = false, citrus } = Astro.props;
const isStart = Astro.url.pathname.startsWith('/start');
const isGuides = Astro.url.pathname.startsWith('/guides');
const isReference = Astro.url.pathname.includes('failure-list');
const ogImage = new URL('/og.jpg', Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lemon Agent: learn the scope, plan, watch, verify, review loop for coding agents." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{Astro.url.pathname === '/' ? title : `${title} · Lemon Agent`}</title>
    <PostHog />
  </head>
  <body class={citrus ? `citrus-${citrus}` : undefined}>
    <main class:list={{ wide }}>
      <header class="site-header">
        <a class="site-brand" href="/" aria-label="Lemon Agent home">
          <img src="/favicon.svg" alt="" class="mark" />
          <span>LEMON AGENT</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a class:list={{ active: isStart }} aria-current={isStart ? 'page' : undefined} href="/start/">Start here</a>
          <a class:list={{ active: isGuides }} aria-current={isGuides ? 'page' : undefined} href="/guides/">Field manual</a>
          <a class:list={{ active: isReference }} aria-current={isReference ? 'page' : undefined} href="/agent-workflow-failure-list/">Watch-outs</a>
        </nav>
      </header>
      <slot />
      <footer>
        <p>
          <span class="chip">LEMON AGENT</span> practical guides and
          skills for working with agents.
        </p>
        <p>
          House rule: nothing ships without a working answer to
          <em>"how would you actually use this?"</em>
        </p>
        <p>
          Incubating: <a href="/craft/">the craft pages</a> (writing, work,
          audio, science): published, unlisted, and out of the nav
          until they earn it.
        </p>
        <p>
          Provenance: mostly AI-generated, human-guided and reviewed.
          Run by <a href="https://nickdonohue.net" rel="me">Nick Donohue</a> —
          the counterpart to <a href="https://lemon.audio">LEMON AUDIO</a>.
        </p>
        <p class="agents">
          For agents: <a href="/catalog.json">catalog.json</a> ·
          <a href="/llms.txt">llms.txt</a> · raw markdown under
          <code>/start/</code>, <code>/guides/</code>, and <code>/lists/</code>
        </p>
      </footer>
    </main>
    <script>
      // Copy buttons on every code block. Each <pre> is wrapped so the
      // button stays put while wide code scrolls underneath it. Blocks
      // that bring their own copy button (the brief builder) opt out
      // with data-no-copy.
      const COPY_ICON =
        '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 3.5v-1a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h1"/></svg>';
      const CHECK_ICON =
        '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7-8"/></svg>';

      document.querySelectorAll('main pre').forEach((pre) => {
        if (pre.matches('[data-no-copy]') || pre.closest('[data-no-copy]')) return;

        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        wrap.style.margin = getComputedStyle(pre).margin;
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        pre.style.margin = '0';

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.setAttribute('aria-label', 'Copy code');
        btn.title = 'Copy code';
        btn.innerHTML = COPY_ICON;

        let resetTimer;
        btn.addEventListener('click', async () => {
          const text = pre.innerText.replace(/\n$/, '');
          try {
            await navigator.clipboard.writeText(text);
            btn.innerHTML = CHECK_ICON;
            btn.classList.add('copied');
            btn.setAttribute('aria-label', 'Copied');
          } catch {
            // No clipboard access: select the block so a manual copy works.
            const range = document.createRange();
            range.selectNodeContents(pre);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            btn.setAttribute('aria-label', 'Press Ctrl+C or Cmd+C to copy');
          }
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            btn.innerHTML = COPY_ICON;
            btn.classList.remove('copied');
            btn.setAttribute('aria-label', 'Copy code');
          }, 1600);
        });

        wrap.appendChild(btn);
      });
    </script>
    <Analytics />
  </body>
</html>

<style is:global>
  /* LEMON AUDIO visual language, softened for long-form reading. */
  :root {
    color-scheme: light dark;
    --chartreuse: #c7d86f;
    --bg: #f5f3e9;
    --ink: #24271f;
    --muted: #666c5d;
    --accent-ink: #5e7024;
    --border: rgba(36, 39, 31, 0.15);
    --border-hover: #8b9d43;
    --card: #fbfaf4;
    --card-hover: rgba(199, 216, 111, 0.13);
    --note-bg: rgba(199, 216, 111, 0.15);
    --code-ink: #454a3e;
    --code-bg: rgba(36, 39, 31, 0.07);
    --term-bg: #151710;
    --term-ink: #dfe3d4;
    --term-muted: #aeb5a4;
    --chip-ink: #202319;
    --live-ink: #3e7046;
    --live-bg: rgba(62, 112, 70, 0.12);
    --glow: none;
    /* Domain accent trio — lemon by default; citrus classes override.
       House chrome (brand chips, selection, terminals) stays on
       --chartreuse regardless of domain. */
    --accent: #c7d86f;
    --accent-ink: #5e7024;
    --accent-soft: rgba(199, 216, 111, 0.15);
    --accent-hover: #8b9d43;
  }
  /* The citrus family: each guide wears a variety of the same fruit.
     `.citrus-lemon` restates the house defaults so a page can opt into
     lemon explicitly rather than falling through to it silently. */
  .citrus-lemon { --accent: #c7d86f; --accent-ink: #5e7024; --accent-soft: rgba(199, 216, 111, 0.15); --accent-hover: #8b9d43; }
  .citrus-lime { --accent: #a4ce54; --accent-ink: #47761b; --accent-soft: rgba(164, 206, 84, 0.16); --accent-hover: #7ba03c; }
  .citrus-tangerine { --accent: #f2ab52; --accent-ink: #8f5312; --accent-soft: rgba(242, 171, 82, 0.16); --accent-hover: #c98836; }
  .citrus-grapefruit { --accent: #f293a2; --accent-ink: #a63a52; --accent-soft: rgba(242, 147, 162, 0.16); --accent-hover: #cd6f80; }
  .citrus-blood-orange { --accent: #ef7c50; --accent-ink: #a23c1a; --accent-soft: rgba(239, 124, 80, 0.15); --accent-hover: #c96438; }
  .citrus-yuzu { --accent: #e8c94e; --accent-ink: #82660a; --accent-soft: rgba(232, 201, 78, 0.16); --accent-hover: #bfa136; }
  /* Craft pages wear no citrus (owner decision 2026-08-07): the varieties
     above belong to the guides and lists; craft pages use the lemon base. */
  @media (prefers-color-scheme: dark) {
    :root {
      --chartreuse: #b8c970;
      --bg: #12140f;
      --ink: #dde1d4;
      --muted: #969d8c;
      --accent-ink: #bdcf78;
      --border: rgba(189, 207, 120, 0.16);
      --border-hover: #87964f;
      --card: #171a14;
      --card-hover: #1c2117;
      --note-bg: #1b2117;
      --code-ink: #c8cfbb;
      --code-bg: rgba(189, 207, 120, 0.09);
      --term-bg: #0b0d09;
      --term-ink: #d9ddcf;
      --live-ink: #86b88a;
      --live-bg: rgba(82, 124, 87, 0.18);
      --glow: 0 4px 18px rgba(0, 0, 0, 0.16);
      --accent: #b8c970;
      --accent-ink: #bdcf78;
      --accent-soft: rgba(189, 207, 120, 0.10);
      --accent-hover: #87964f;
    }
    .citrus-lemon { --accent: #b8c970; --accent-ink: #bdcf78; --accent-soft: rgba(189, 207, 120, 0.10); --accent-hover: #87964f; }
    .citrus-lime { --accent: #a6cd62; --accent-ink: #accf7f; --accent-soft: rgba(166, 205, 98, 0.11); --accent-hover: #84a34e; }
    .citrus-tangerine { --accent: #eab066; --accent-ink: #e9b788; --accent-soft: rgba(234, 176, 102, 0.11); --accent-hover: #b98a4d; }
    .citrus-grapefruit { --accent: #ea97a6; --accent-ink: #eda6b2; --accent-soft: rgba(234, 151, 166, 0.11); --accent-hover: #b97684; }
    .citrus-blood-orange { --accent: #e98a64; --accent-ink: #eda184; --accent-soft: rgba(233, 138, 100, 0.11); --accent-hover: #b96e4d; }
    .citrus-yuzu { --accent: #e0c465; --accent-ink: #e3cd85; --accent-soft: rgba(224, 196, 101, 0.11); --accent-hover: #b29a4f; }
  }

  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--ink);
    -webkit-text-size-adjust: 100%;
  }
  /* Per-domain signature: a thin accent bar across the top of the page. */
  body::before {
    content: '';
    display: block;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), transparent 85%);
  }
  ::selection { background: var(--chartreuse); color: var(--chip-ink); }
  main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
  main.wide { max-width: 72rem; }

  a { color: var(--accent-ink); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }

  h1 {
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0.4rem 0 1rem;
  }
  h2 {
    font-size: clamp(1.35rem, 3.2vw, 1.7rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 2.8rem 0 0.8rem;
  }
  h2::before { content: '// '; color: var(--accent-ink); }

  code {
    font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
    font-size: 0.92em;
    background: var(--code-bg);
    color: var(--code-ink);
    padding: 0.08em 0.35em;
  }
  /* Fenced blocks render as terminals in both themes: the brand's home turf */
  pre {
    font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
    background: var(--term-bg);
    color: var(--term-ink);
    border: 1px solid var(--border);
    padding: 0.85rem 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  pre code { background: none; color: inherit; padding: 0; font-size: inherit; }

  /* Copy buttons (injected by the script in this layout). The wrapper is
     the positioning context so the button holds still while code scrolls. */
  .code-wrap { position: relative; }
  .code-copy {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.32rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    color: var(--term-muted);
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 120ms ease, color 120ms ease, background 120ms ease;
  }
  .code-wrap:hover .code-copy,
  .code-copy:focus-visible { opacity: 1; }
  .code-copy:hover { background: rgba(255, 255, 255, 0.12); color: var(--term-ink); }
  .code-copy:focus-visible { outline: 2px solid var(--chartreuse); outline-offset: 1px; }
  .code-copy.copied { color: var(--chartreuse); opacity: 1; }
  .code-copy svg { display: block; }

  .chip {
    display: inline-block;
    background: var(--chartreuse);
    color: var(--chip-ink);
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.05em 0.45em;
  }


  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 4rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .site-brand {
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
  }
  .site-brand:hover { color: var(--accent-ink); }
  .mark { width: 1.15em; height: 1.15em; }
  .site-nav { display: flex; align-items: center; gap: 1.25rem; }
  .site-nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 650;
  }
  .site-nav a:hover,
  .site-nav a.active { color: var(--accent-ink); }
  .site-nav a.active { text-decoration: underline; text-underline-offset: 0.45em; }

  .kicker {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6em;
    flex-wrap: wrap;
    font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
  }

  .badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.1em 0.5em;
  }
  .badge.draft { color: var(--chip-ink); background: var(--chartreuse); }
  .badge.live, .badge.published { color: var(--live-ink); background: var(--live-bg); }
  .badge.v0 { color: var(--chip-ink); background: var(--accent); }
  .badge.scoping { color: var(--muted); border: 1px solid var(--border); background: transparent; }
  .badge.available { color: var(--live-ink); background: var(--live-bg); }
  .badge.prompt, .badge.guide { color: var(--chip-ink); background: var(--accent); }
  .badge.in-development { color: var(--muted); border: 1px solid var(--border); background: transparent; }

  /* Rendered list body */
  .list-body blockquote {
    margin: 1.4rem 0;
    padding: 0.75rem 1.1rem;
    border-left: 2px solid var(--accent);
    background: var(--accent-soft);
    font-size: 0.9rem;
  }
  .list-body blockquote p { margin: 0.4rem 0; }
  .list-body ol { padding-left: 1.5rem; }
  .list-body ol li { margin: 0.9rem 0; }
  .list-body hr { border: 0; border-top: 1px solid var(--border); margin: 2.5rem 0 1.5rem; }
  .list-body hr ~ p { color: var(--muted); font-size: 0.85rem; }
  /* A comparison table wider than the reading column scrolls inside
     itself rather than pushing the whole page sideways (same call as the
     claim ledger on /work/verify-info). */
  .list-body table { display: block; max-width: 100%; overflow-x: auto; }

  /* Interactive examples: CSS-only (radio + sibling selectors) */
  .xmpl {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 1rem 1.1rem;
    margin: 1.6rem 0;
    font-size: 0.88rem;
  }
  .xmpl-head { margin: 0 0 0.9rem; font-weight: 700; letter-spacing: 0.03em; }
  .xmpl-head .chip { font-size: 0.68rem; margin-right: 0.3em; }
  .xmpl-turn { display: flex; gap: 0.7em; margin: 0.55rem 0; }
  .xmpl-role {
    flex: 0 0 3.2em;
    text-align: right;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.35em;
  }
  .xmpl-turn-agent .xmpl-role { color: var(--accent-ink); }
  .xmpl-text {
    flex: 1;
    border: 1px solid var(--border);
    padding: 0.45rem 0.7rem;
    background: var(--bg);
  }
  .xmpl-turn-agent .xmpl-text { border-left: 2px solid var(--accent); }
  .xmpl-text p { margin: 0.3rem 0; }
  .xmpl-q { margin: 1.1rem 0 0.6rem; font-weight: 700; }
  .xmpl-q::before { content: '// '; color: var(--accent-ink); }
  .xmpl-radio { position: absolute; opacity: 0; pointer-events: none; }
  .xmpl-opt {
    display: flex;
    gap: 0.7em;
    align-items: baseline;
    border: 1px solid var(--border);
    background: var(--bg);
    padding: 0.55rem 0.75rem;
    margin: 0.45rem 0;
    cursor: pointer;
  }
  .xmpl-opt:hover { border-color: var(--accent-hover); }
  .xmpl-radio:focus-visible + .xmpl-opt { outline: 2px solid var(--accent); }
  .xmpl-radio:checked + .xmpl-opt {
    border-color: var(--accent-hover);
    background: var(--accent-soft);
  }
  .xmpl-key {
    flex: 0 0 auto;
    color: var(--chip-ink);
    background: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.05em 0.45em;
  }
  .xmpl-outcome { display: none; margin: 0.3rem 0 1rem 1.5rem; }
  .xmpl-radio:checked + .xmpl-opt + .xmpl-outcome { display: block; }
  .xmpl-verdict {
    border: 1px solid var(--border);
    border-left-width: 2px;
    padding: 0.5rem 0.75rem;
    margin-top: 0.7rem;
  }
  .xmpl-verdict p { margin: 0.35rem 0 0; }
  .xmpl-verdict-chip {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.08em 0.5em;
  }
  .xmpl-verdict-correct { border-left-color: var(--accent); }
  .xmpl-verdict-correct .xmpl-verdict-chip { background: var(--accent); color: var(--chip-ink); }
  .xmpl-verdict-baseline { border-left-color: var(--muted); }
  .xmpl-verdict-baseline .xmpl-verdict-chip { background: var(--muted); color: var(--bg); }
  .xmpl-verdict-plausible { border-left-color: var(--live-ink); }
  .xmpl-verdict-plausible .xmpl-verdict-chip { background: var(--live-bg); color: var(--live-ink); }
  .xmpl-cites a { color: var(--muted); font-size: 0.8rem; }

  footer {
    margin-top: 4rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8rem;
  }
  footer p { margin: 0.45rem 0; }
  footer .chip { font-size: 0.7rem; }
  footer .agents,
  footer code { font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; }

  .backlink { margin-top: 2.5rem; font-size: 0.85rem; }

  @media (max-width: 38rem) {
    main { padding-top: 1.25rem; }
    .site-header { align-items: flex-start; margin-bottom: 2.8rem; }
    .site-nav { gap: 0.8rem; flex-wrap: wrap; justify-content: flex-end; }
    .site-nav a { font-size: 0.78rem; }
    .site-brand span { display: none; }
    .site-brand .mark { width: 1.6rem; height: 1.6rem; }
  }
</style>

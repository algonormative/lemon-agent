# PostHog. Optional everywhere: with no key the site builds, boots and serves
# exactly as it always did, and every capture in src/components/Analytics.astro
# is a no-op. `npm run dev` says so in the console rather than leaving an empty
# graph to be discovered in a month.
#
# The token is baked in at BUILD time (static site — there is no later moment to
# read it), so CI needs it as a repository secret:
#
#   gh secret set PUBLIC_POSTHOG_KEY --repo algonormative/lemon-agent
#
# `phc_` tokens are ingestion-only and ship in the HTML of every page, so this
# is not a secret in the cryptographic sense — it lives in the secret store so a
# public repo does not carry a harvestable ingestion endpoint.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
